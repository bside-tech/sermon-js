{
  "name": "sermon-js",
  "version": "0.5.0",
  "description": "Service monitor: build status pages fast. Typed checks and presets, sleep-safe probes, scoring, history, a host-agnostic API and a React UI kit.",
  "license": "MIT",
  "author": "BSide-Tech",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bside-tech/sermon-js.git"
  },
  "homepage": "https://github.com/bside-tech/sermon-js#readme",
  "bugs": "https://github.com/bside-tech/sermon-js/issues",
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "engines": {
    "node": ">=20"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "typesVersions": {
    "*": {
      "api": [
        "./dist/api/index.d.cts"
      ],
      "presets": [
        "./dist/presets/index.d.cts"
      ],
      "stores/upstash": [
        "./dist/stores/upstash.d.cts"
      ],
      "stores/redis": [
        "./dist/stores/redis.d.cts"
      ],
      "stores/sql": [
        "./dist/stores/sql.d.cts"
      ],
      "stores/mongodb": [
        "./dist/stores/mongodb.d.cts"
      ],
      "react": [
        "./dist/react/index.d.cts"
      ],
      "react/heroui": [
        "./dist/react/heroui/index.d.cts"
      ],
      "testing": [
        "./dist/testing/index.d.cts"
      ]
    }
  },
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./api": {
      "import": {
        "types": "./dist/api/index.d.ts",
        "default": "./dist/api/index.js"
      },
      "require": {
        "types": "./dist/api/index.d.cts",
        "default": "./dist/api/index.cjs"
      }
    },
    "./presets": {
      "import": {
        "types": "./dist/presets/index.d.ts",
        "default": "./dist/presets/index.js"
      },
      "require": {
        "types": "./dist/presets/index.d.cts",
        "default": "./dist/presets/index.cjs"
      }
    },
    "./stores/upstash": {
      "import": {
        "types": "./dist/stores/upstash.d.ts",
        "default": "./dist/stores/upstash.js"
      },
      "require": {
        "types": "./dist/stores/upstash.d.cts",
        "default": "./dist/stores/upstash.cjs"
      }
    },
    "./stores/redis": {
      "import": {
        "types": "./dist/stores/redis.d.ts",
        "default": "./dist/stores/redis.js"
      },
      "require": {
        "types": "./dist/stores/redis.d.cts",
        "default": "./dist/stores/redis.cjs"
      }
    },
    "./stores/sql": {
      "import": {
        "types": "./dist/stores/sql.d.ts",
        "default": "./dist/stores/sql.js"
      },
      "require": {
        "types": "./dist/stores/sql.d.cts",
        "default": "./dist/stores/sql.cjs"
      }
    },
    "./stores/mongodb": {
      "import": {
        "types": "./dist/stores/mongodb.d.ts",
        "default": "./dist/stores/mongodb.js"
      },
      "require": {
        "types": "./dist/stores/mongodb.d.cts",
        "default": "./dist/stores/mongodb.cjs"
      }
    },
    "./react": {
      "import": {
        "types": "./dist/react/index.d.ts",
        "default": "./dist/react/index.js"
      },
      "require": {
        "types": "./dist/react/index.d.cts",
        "default": "./dist/react/index.cjs"
      }
    },
    "./react/heroui": {
      "import": {
        "types": "./dist/react/heroui/index.d.ts",
        "default": "./dist/react/heroui/index.js"
      },
      "require": {
        "types": "./dist/react/heroui/index.d.cts",
        "default": "./dist/react/heroui/index.cjs"
      }
    },
    "./react/heroui/styles.css": "./dist/react/heroui/styles.css",
    "./testing": {
      "import": {
        "types": "./dist/testing/index.d.ts",
        "default": "./dist/testing/index.js"
      },
      "require": {
        "types": "./dist/testing/index.d.cts",
        "default": "./dist/testing/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest --run --typecheck",
    "test:watch": "vitest",
    "changeset": "changeset",
    "release": "node scripts/assert-versioned.mjs && pnpm build && changeset publish",
    "prebuild": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "version": "changeset version"
  },
  "keywords": [
    "status-page",
    "uptime",
    "monitoring",
    "health-check",
    "service-monitor"
  ],
  "devDependencies": {
    "@changesets/cli": "^2.27.9",
    "@edge-runtime/vm": "^5.0.0",
    "@eslint/js": "^9.22.0",
    "@heroui/react": "^3.2.6",
    "@heroui/styles": "^3.2.6",
    "@tanstack/react-query": "^5.104.2",
    "@testing-library/react": "^16.3.3",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^22.18.6",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "better-sqlite3": "^12.11.1",
    "esbuild": "^0.28.2",
    "eslint": "^9.22.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^16.0.0",
    "happy-dom": "^20.14.6",
    "ioredis": "^6.0.0",
    "mongodb": "^7.7.0",
    "mysql2": "^3.24.5",
    "pg": "^8.23.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwind-variants": "^3.3.1",
    "tailwindcss": "^4.3.3",
    "tsup": "^8.3.5",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.26.1",
    "vitest": "^2.1.6"
  },
  "packageManager": "pnpm@9.15.9",
  "dependencies": {
    "aws4fetch": "^1.0.20"
  },
  "peerDependencies": {
    "@heroui/react": ">=3",
    "@tanstack/react-query": ">=5",
    "react": ">=18"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "@tanstack/react-query": {
      "optional": true
    },
    "@heroui/react": {
      "optional": true
    }
  }
}
